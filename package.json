{
  "name": "seterraline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/game/*.test.ts src/map/*.test.ts src/effects/*.test.ts server/*.test.ts",
    "data": "node scripts/prepare-data.mjs",
    "server:dev": "wrangler dev",
    "server:check": "tsc -p tsconfig.server.json",
    "server:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "d3-geo": "^3.1.1",
    "earcut": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/d3-geo": "^3.1.0",
    "@types/earcut": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "flag-icons": "^7.5.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "wrangler": "^4.156.0"
  }
}
