{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seterraline-party",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-30",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PartyRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }],
  "vars": { "ALLOWED_ORIGINS": "https://pizzabiceps.github.io,http://127.0.0.1:5173,http://localhost:5173" }
}
